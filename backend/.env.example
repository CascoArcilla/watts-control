# Este env es usado en caso de no usar Docker.
# Para tu entorno local (ejecutando backend directamente)

# =============================================================================
# CONEXIÓN A BASE DE DATOS POSTGRESQL
# =============================================================================
# Dos modos de conexión:
# 1. LOCAL/STANDARD: PostgreSQL local o remoto estándar (puerto 5432)
# 2. SUPABASE POOLER: Transaction pooler de Supabase (puerto 6543)

# Dialecto de base de datos (postgres)
EC_DB_DIALECT=postgres

# --- MODO LOCAL/STANDARD (default) ---
# Host de la base de datos (localhost para local, IP/hostname para remoto)
EC_DB_HOST=localhost
# Puerto de PostgreSQL (5432 estándar)
EC_DB_PORT=5432
# Nombre de la base de datos
EC_DB_NAME=your_db_name
# Usuario de PostgreSQL
EC_DB_USER=your_username
# Contraseña del usuario
EC_DB_PASSWORD=your_password

# --- MODO SUPABASE TRANSACTION POOLER ---
# Habilitar modo pooler (true | false) - usa puerto 6543 y SSL obligatorio
# EC_DB_POOLER=true
# Host del pooler de Supabase (ej: aws-0-us-east-1.pooler.supabase.com)
# EC_DB_HOST=your-project-ref.pooler.supabase.com
# Puerto fijo 6543 (se ignora EC_DB_PORT si EC_DB_POOLER=true)
# EC_DB_PORT=6543
# Mismo usuario/contraseña/BD que el proyecto Supabase
# EC_DB_NAME=postgres
# EC_DB_USER=postgres.your-project-ref
# EC_DB_PASSWORD=your-supabase-password

# Esquema donde se crearán las tablas (default: backend_app)
EC_DB_SCHEMA=backend_app

# Habilitar SSL para conexiones (true | false)
# Obligatorio para Supabase Pooler y managed PostgreSQL
# En local puede ser false
EC_DB_SSL=false

# Logging de queries SQL en desarrollo (true | false)
EC_DB_LOGGING=false

# =============================================================================
# VARIABLES NECESARIAS PARA JWT
# =============================================================================
EC_SECRET_KEY="your_jwt_secret_key"
REFRESH_SECRET="your_jwt_refresh_secret"

# =============================================================================
# ENTORNO DE EJECUCIÓN
# =============================================================================
# development | production
NODE_ENV=development

# =============================================================================
# CORS - URL DEL FRONTEND
# =============================================================================
# Ajusta si se despliega en otro servidor/servicio
EC_REACT_APP="http://localhost:5173"

# =============================================================================
# USUARIO ADMINISTRADOR INICIAL (opcional, para createAdminUser.js)
# =============================================================================
# EC_SYS_USERNAME="admin_user"
# EC_SYS_PASSWORD="AdminPass!123"