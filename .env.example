##############################################################################
# Este archivo es solo un ejemplo para .env que usa docker compose en desarrollo
##############################################################################

# Credenciales para acceder a la base de datos PostgreSQL desde la app Express
# ---------------------------------------------------------------

# Nombre del servicio de db en docker compose (hostname de red)
EC_DB_HOST=ec-db-postgres

# Dialecto de base de datos (postgres | mysql)
EC_DB_DIALECT=postgres

# Contraseña del usuario de PostgreSQL (igual a POSTGRES_PASSWORD)
EC_DB_PASSWORD=postgres_password

# Nombre de base de datos (igual a POSTGRES_DB)
EC_DB_NAME=ec_control

# Usuario de PostgreSQL (igual a POSTGRES_USER)
EC_DB_USER=postgres

# Puerto interno de PostgreSQL (usualmente 5432)
EC_DB_PORT=5432

# Esquema donde se crearán las tablas (default: backend_app)
EC_DB_SCHEMA=backend_app

# Habilitar SSL para conexiones a Supabase/PostgreSQL gestionado (true | false)
EC_DB_SSL=false

# Credenciales del primer usuario administrador
# -----------------------------------------------

# Nombre de usuario (debe seguir el regex en ./backend/consts/regexUsername.js)
# Empieza con letra, 6-18 caracteres: letras, números, _, ., -
EC_SYS_USERNAME=admin_1

# Contraseña (debe seguir el regex en ./backend/consts/regexPassword.js)
# 8-16 caracteres: mayúscula, minúscula, número, carácter especial @$!%*?&
EC_SYS_PASSWORD=root_password

# Variables necesarias para JWT
EC_SECRET_KEY=your_secret_key_for_jwt
REFRESH_SECRET=your_refresh_secret_for_jwt

# URL del frontend para CORS (usado en desarrollo)
EC_REACT_APP=http://localhost:9300

# Entorno de ejecución (development | production)
NODE_ENV=development

# URL de la API, usada en las llamadas fetch/axios del frontend
VITE_API_URL=http://localhost:9200